# 第一次建议保持默认值。模型会在首次准备时下载到项目的 .cache 目录。
ASR_MODEL=Systran/faster-whisper-small
ASR_DEVICE=cuda
LLM_MODEL=Qwen/Qwen2.5-3B-Instruct
LLM_QUANTIZATION=4bit
TTS_ENGINE=sapi
TTS_VOICE=zh-CN-XiaoxiaoNeural
SAPI_VOICE=Microsoft Huihui Desktop
SERVER_PORT=7860
MODEL_OFFLINE=1
# 电脑 Demo 默认由页面开关启用；设备开机自启时改为 1。
HANDS_FREE_AUTO_START=0
# 留空使用 Windows 默认麦克风，也可填写 sounddevice 设备编号或名称。
AUDIO_INPUT_DEVICE=
# 轻量电脑声纹基线；量产版可在相同端口替换为 ECAPA/RKNN。
VOICEPRINT_THRESHOLD=0.82
VOICEPRINT_REQUIRED_SAMPLES=3
# 自定义内容会在页面修改后保存到 .cache/device/wake_word.json。
WAKE_WORD=小夜灯
WAKE_SESSION_SECONDS=30
